{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leolem",
  "compatibility_date": "2026-11-24",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "leolem.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "ratelimits": [{ "name": "SIGNUPS", "namespace_id": "39001", "simple": { "limit": 5, "period": 60 } }],
  "previews": {
    "ratelimits": [{ "name": "SIGNUPS", "namespace_id": "39002", "simple": { "limit": 5, "period": 60 } }]
  }
}
